# Twilio Configuration
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

# User's phone number for SMS notifications
USER_PHONE_NUMBER=+1234567890

# Polling interval in seconds (default: 60)
POLL_INTERVAL_SECONDS=60

# Notification cooldown in minutes (default: 15)
COOLDOWN_MINUTES=15

# Database path (default: ./data/poker.db)
DB_PATH=./data/poker.db

# Log file path (default: ./data/poker-notifier.log)
LOG_FILE_PATH=./data/poker-notifier.log

# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info
